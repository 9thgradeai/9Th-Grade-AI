{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
