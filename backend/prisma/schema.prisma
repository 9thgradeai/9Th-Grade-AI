// 9Th-Grade AI — Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & Auth ──────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String?
  name              String
  firstName         String
  timezone          String   @default("Asia/Dhaka")
  avatar            String?
  onboardingData    Json?    // Exam preferences, study time, etc.
  role              String   @default("user") // user | admin
  emailVerified     Boolean  @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  subjects          UserSubject[]
  userTopics        UserTopic[]
  tests             Test[]
  testResults       TestResult[]
  performance       Performance[]
  aiRecommendations AIRecommendation[]
  dailyTasks        DailyTask[]
  roadmaps          Roadmap[]
  revisionItems     RevisionItem[]
  studySessions     StudySession[]
  subscription      Subscription?
  invoices          Invoice[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Exams & Syllabus ──────────────────────────────────────

model Exam {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  shortName            String
  tagline              String
  description          String
  color                String
  icon                 String
  configurableSyllabus Boolean   @default(true)
  createdAt            DateTime  @default(now())

  subjects   Subject[]
  tests      Test[]
  performance Performance[]
  roadmaps   Roadmap[]
  userSubjects UserSubject[]
}

model Subject {
  id       String  @id @default(cuid())
  examId   String
  name     String
  nameBn   String?
  weight   Int
  sortOrder Int    @default(0)

  exam     Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  topics   Topic[]
  userSubjects UserSubject[]

  @@index([examId])
}

// ─── Enhanced Hierarchy: Topic → SubTopic ──────────────────

model Topic {
  id         String  @id @default(cuid())
  subjectId  String
  name       String
  nameBn     String?
  sortOrder  Int     @default(0)
  mastery    Int     @default(0)
  accuracy   Int     @default(0)
  speed      Int     @default(0)
  retention  Int     @default(0)
  status     String  @default("locked") // locked | learning | practicing | mastered
  reviewDue  Int?

  subject    Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subTopics  SubTopic[]
  questions  Question[]
  userTopics UserTopic[]
  revisionItems RevisionItem[]

  @@index([subjectId])
}

model SubTopic {
  id        String  @id @default(cuid())
  topicId   String
  name      String
  nameBn    String?
  sortOrder Int     @default(0)

  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([topicId])
}

// ─── User Progress (per-user subject/topic state) ──────────

model UserSubject {
  id       String @id @default(cuid())
  userId   String
  examId   String
  subjectId String
  mastery  Int    @default(0)
  accuracy Int    @default(0)
  speed    Int    @default(0)
  retention Int   @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
}

model UserTopic {
  id        String @id @default(cuid())
  userId    String
  topicId   String
  mastery   Int    @default(0)
  accuracy  Int    @default(0)
  speed     Int    @default(0)
  retention Int    @default(0)
  status    String @default("locked")
  reviewDue Int?

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}

// ─── Questions & Tests ─────────────────────────────────────

model Question {
  id               String   @id @default(cuid())
  subTopicId       String?
  topicId          String   // Keep for backward compatibility

  // Content (normalized)
  content          QuestionContent?

  // Metadata
  questionType     String   @default("mcq-single") // 'mcq-single' | 'mcq-multiple' | 'fill-blank'
  difficulty       Int      @default(2)            // 1-5, AI-adjustable
  targetSeconds    Int      @default(40)

  // Classification
  tags             String[]
  bloomLevel       String?                          // 'remember' | 'understand' | 'apply' | 'analyze'

  // Quality & Status
  // Lifecycle: IMPORTED → NEEDS_REVIEW → VALIDATED → PUBLISHED → ARCHIVED → REJECTED
  status           String   @default("IMPORTED")
  verificationStatus String @default("unverified")  // 'unverified' | 'verified' | 'disputed'

  // Deduplication
  contentHash      String?                          // SHA-256 of normalized prompt
  canonicalId      String?                          // Points to canonical if duplicate
  isCanonical      Boolean  @default(true)

  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  publishedAt      DateTime?

  // Relations
  topic            Topic                  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subTopic         SubTopic?              @relation(fields: [subTopicId], references: [id], onDelete: SetNull)
  source           QuestionSource?
  versions         QuestionVersion[]
  stats            QuestionStats?
  currentAffairs   CurrentAffairsQuestion?
  attempts         QuestionAttempt[]

  @@index([topicId])
  @@index([subTopicId])
  @@index([status])
  @@index([contentHash])
  @@unique([contentHash])
  @@index([canonicalId])
  @@index([difficulty])
  @@index([topicId, status, difficulty])
  @@index([subTopicId, status, difficulty])
}

model QuestionContent {
  id                    String   @id @default(cuid())
  questionId            String   @unique
  prompt                String
  promptBn              String?
  options               Json     // [{text: "...", textBn: "..."}, ...]
  correctIndex          Int
  explanation           String
  explanationBn         String?
  detailedExplanation   String?  // For AI Tutor context

  question              Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionSource {
  id              String   @id @default(cuid())
  questionId      String   @unique
  examYear        Int?              // BCS year (e.g., 40, 41, 42)
  questionNumber  Int?              // Question number in that exam
  sourceType      String            // 'bcs-official' | 'bcs-unofficial' | 'curated' | 'ai-generated'
  sourceName      String?
  sourceUrl       String?
  verifiedAt      DateTime?
  verifiedBy      String?           // User ID of verifier

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionVersion {
  id            String   @id @default(cuid())
  questionId    String
  version       Int
  prompt        String
  promptBn      String?
  options       Json
  correctIndex  Int
  explanation   String
  changedBy     String?
  changedAt     DateTime @default(now())
  changeReason  String?

  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, version])
  @@index([questionId])
}

model QuestionStats {
  id               String   @id @default(cuid())
  questionId       String   @unique
  attemptCount     Int      @default(0)
  correctCount     Int      @default(0)
  avgTimeSeconds   Float    @default(0)
  difficultyRating Float    @default(0)   // Computed from actual performance

  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model CurrentAffairsQuestion {
  id              String   @id @default(cuid())
  questionId      String   @unique
  eventDate       DateTime
  publicationDate DateTime @default(now())
  validUntil      DateTime?
  sourceType      String         // 'newspaper' | 'government' | 'international' | 'ai-generated'
  sourceName      String?
  sourceUrl       String?
  status          String   @default("active")  // 'active' | 'expired' | 'archived'

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([validUntil])
  @@index([status])
}

model Test {
  id              String   @id @default(cuid())
  userId          String
  examId          String
  name            String
  kind            String   // adaptive | mock | diagnostic | topic
  subjectId       String?
  topicId         String?
  questionIds     String[]
  durationMinutes Int
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempts QuestionAttempt[]
  result   TestResult?

  @@index([userId, startedAt(sort: Desc)])
}

model QuestionAttempt {
  id               String   @id @default(cuid())
  testId           String
  questionId       String
  selectedIndex    Int?
  correct          Boolean
  timeSpentSeconds Int
  confidence       Int      @default(3) // 1-5
  answeredAt       DateTime @default(now())

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@unique([testId, questionId])
}

// ─── Results & Performance ─────────────────────────────────

model TestResult {
  id               String   @id @default(cuid())
  testId           String   @unique
  userId           String
  score            Int
  accuracy         Int
  speed            Int
  retention        Int
  percentile       Int
  correct          Int
  total            Int
  timeSpentMinutes Int
  diagnosis        String?
  nextBestAction   String?
  targetTopicId    String?
  losses           String?  // JSON: { subjectId: marksLost }
  completedAt      DateTime @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt(sort: Desc)])
}

model Performance {
  id               String   @id @default(cuid())
  userId           String
  examId           String
  mastery          Int      @default(0)
  syllabusCoverage Int      @default(0)
  consistency      Int      @default(0)
  accuracy         Int      @default(0)
  speed            Int      @default(0)
  retention        Int      @default(0)
  examReadiness    Int      @default(0)
  potentialScore   Int      @default(0)
  percentile       Float    @default(0)
  trajectory       String?  // JSON array of numbers
  studyHistory     String?  // JSON array of {day, minutes}
  streakDays       Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([userId, examId])
}

// ─── AI & Strategy ─────────────────────────────────────────

model AIRecommendation {
  id          String    @id @default(cuid())
  userId      String
  kind        String    // diagnosis | action | strategy | memory | alert
  severity    String    // low | medium | high
  title       String
  body        String
  actionLabel String?
  actionRoute String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model DailyTask {
  id                String   @id @default(cuid())
  userId            String
  subject           String
  topic             String
  kind              String   // practice | revision | test | review
  durationMinutes   Int
  priority          String   // high | medium | low
  impact            String   // high | medium | low
  expectedQuestions Int?
  status            String   @default("pending") // pending | done
  date              DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Roadmap {
  id                String   @id @default(cuid())
  userId            String
  examId            String
  examName          String
  examDate          DateTime
  daysRemaining     Int
  currentMastery    Int
  targetMastery     Int
  dailyEffortMinutes Int
  phases            String?  // JSON array of phases
  priorities        String?  // JSON array of strings
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
}

// ─── Memory & Revision ─────────────────────────────────────

model RevisionItem {
  id             String   @id @default(cuid())
  userId         String
  topicId        String
  memoryStrength Int      @default(50)
  lastReviewed   DateTime @default(now())
  nextReview     DateTime
  overdue        Boolean  @default(false)

  // SM-2 state
  repetition     Int      @default(0)
  easinessFactor Float    @default(2.5)
  interval       Int      @default(0) // days

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, nextReview])
}

model StudySession {
  id      String   @id @default(cuid())
  userId  String
  date    DateTime @default(now())
  minutes Int
  tasks   String?  // JSON array of task descriptions

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date(sort: Desc)])
}

// ─── Subscriptions & Payments ──────────────────────────────

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  plan                  String   @default("free") // free | pro | enterprise
  status                String   @default("active") // active | canceled | past_due
  currentPeriodEnd      DateTime?

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
}

model Invoice {
  id               String   @id @default(cuid())
  userId           String
  subscriptionId   String?
  stripeInvoiceId  String?
  amount           Int      // in cents
  status           String   // paid | pending | failed
  createdAt        DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}