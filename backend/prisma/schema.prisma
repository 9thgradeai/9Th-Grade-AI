// 9Th-Grade AI — Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & Auth ──────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String?
  name              String
  firstName         String
  timezone          String   @default("Asia/Dhaka")
  avatar            String?
  onboardingData    Json?    // Exam preferences, study time, etc.
  role              String   @default("user") // user | admin
  emailVerified     Boolean  @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  subjects          UserSubject[]
  userTopics        UserTopic[]
  tests             Test[]
  testResults       TestResult[]
  performance       Performance[]
  aiRecommendations AIRecommendation[]
  dailyTasks        DailyTask[]
  roadmaps          Roadmap[]
  revisionItems     RevisionItem[]
  studySessions     StudySession[]
  subscription      Subscription?
  invoices          Invoice[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Exams & Syllabus ──────────────────────────────────────

model Exam {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  shortName            String
  tagline              String
  description          String
  color                String
  icon                 String
  configurableSyllabus Boolean   @default(true)
  createdAt            DateTime  @default(now())

  subjects   Subject[]
  tests      Test[]
  performance Performance[]
  roadmaps   Roadmap[]
  userSubjects UserSubject[]
}

model Subject {
  id       String  @id @default(cuid())
  examId   String
  name     String
  nameBn   String?
  weight   Int
  sortOrder Int    @default(0)

  exam     Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  topics   Topic[]
  userSubjects UserSubject[]

  @@index([examId])
}

model Topic {
  id         String  @id @default(cuid())
  subjectId  String
  name       String
  mastery    Int     @default(0)
  accuracy   Int     @default(0)
  speed      Int     @default(0)
  retention  Int     @default(0)
  status     String  @default("locked") // locked | learning | practicing | mastered
  reviewDue  Int?

  subject    Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions  Question[]
  userTopics UserTopic[]
  revisionItems RevisionItem[]

  @@index([subjectId])
}

// ─── User Progress (per-user subject/topic state) ──────────

model UserSubject {
  id       String @id @default(cuid())
  userId   String
  examId   String
  subjectId String
  mastery  Int    @default(0)
  accuracy Int    @default(0)
  speed    Int    @default(0)
  retention Int   @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
}

model UserTopic {
  id        String @id @default(cuid())
  userId    String
  topicId   String
  mastery   Int    @default(0)
  accuracy  Int    @default(0)
  speed     Int    @default(0)
  retention Int    @default(0)
  status    String @default("locked")
  reviewDue Int?

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}

// ─── Questions & Tests ─────────────────────────────────────

model Question {
  id            String @id @default(cuid())
  topicId       String
  prompt        String
  promptBn      String?
  options       String[] // JSON array of options
  optionsBn     String[] @default([])
  correctIndex  Int
  explanation   String
  difficulty    Int    @default(2) // 1-5
  targetSeconds Int    @default(40)
  tags          String[]

  topic    Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts QuestionAttempt[]

  @@index([topicId])
  @@index([difficulty])
}

model Test {
  id              String   @id @default(cuid())
  userId          String
  examId          String
  name            String
  kind            String   // adaptive | mock | diagnostic | topic
  subjectId       String?
  topicId         String?
  questionIds     String[]
  durationMinutes Int
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempts QuestionAttempt[]
  result   TestResult?

  @@index([userId, startedAt(sort: Desc)])
}

model QuestionAttempt {
  id               String   @id @default(cuid())
  testId           String
  questionId       String
  selectedIndex    Int?
  correct          Boolean
  timeSpentSeconds Int
  confidence       Int      @default(3) // 1-5
  answeredAt       DateTime @default(now())

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([testId])
}

// ─── Results & Performance ─────────────────────────────────

model TestResult {
  id               String   @id @default(cuid())
  testId           String   @unique
  userId           String
  score            Int
  accuracy         Int
  speed            Int
  retention        Int
  percentile       Int
  correct          Int
  total            Int
  timeSpentMinutes Int
  diagnosis        String?
  nextBestAction   String?
  targetTopicId    String?
  losses           String?  // JSON: { subjectId: marksLost }
  completedAt      DateTime @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt(sort: Desc)])
}

model Performance {
  id               String   @id @default(cuid())
  userId           String
  examId           String
  mastery          Int      @default(0)
  syllabusCoverage Int      @default(0)
  consistency      Int      @default(0)
  accuracy         Int      @default(0)
  speed            Int      @default(0)
  retention        Int      @default(0)
  examReadiness    Int      @default(0)
  potentialScore   Int      @default(0)
  percentile       Float    @default(0)
  trajectory       String?  // JSON array of numbers
  studyHistory     String?  // JSON array of {day, minutes}
  streakDays       Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([userId, examId])
}

// ─── AI & Strategy ─────────────────────────────────────────

model AIRecommendation {
  id          String    @id @default(cuid())
  userId      String
  kind        String    // diagnosis | action | strategy | memory | alert
  severity    String    // low | medium | high
  title       String
  body        String
  actionLabel String?
  actionRoute String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model DailyTask {
  id                String   @id @default(cuid())
  userId            String
  subject           String
  topic             String
  kind              String   // practice | revision | test | review
  durationMinutes   Int
  priority          String   // high | medium | low
  impact            String   // high | medium | low
  expectedQuestions Int?
  status            String   @default("pending") // pending | done
  date              DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Roadmap {
  id                String   @id @default(cuid())
  userId            String
  examId            String
  examName          String
  examDate          DateTime
  daysRemaining     Int
  currentMastery    Int
  targetMastery     Int
  dailyEffortMinutes Int
  phases            String?  // JSON array of phases
  priorities        String?  // JSON array of strings
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
}

// ─── Memory & Revision ─────────────────────────────────────

model RevisionItem {
  id             String   @id @default(cuid())
  userId         String
  topicId        String
  memoryStrength Int      @default(50)
  lastReviewed   DateTime @default(now())
  nextReview     DateTime
  overdue        Boolean  @default(false)

  // SM-2 state
  repetition     Int      @default(0)
  easinessFactor Float    @default(2.5)
  interval       Int      @default(0) // days

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, nextReview])
}

model StudySession {
  id      String   @id @default(cuid())
  userId  String
  date    DateTime @default(now())
  minutes Int
  tasks   String?  // JSON array of task descriptions

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date(sort: Desc)])
}

// ─── Subscriptions & Payments ──────────────────────────────

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  plan                  String   @default("free") // free | pro | enterprise
  status                String   @default("active") // active | canceled | past_due
  currentPeriodEnd      DateTime?

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
}

model Invoice {
  id               String   @id @default(cuid())
  userId           String
  subscriptionId   String?
  stripeInvoiceId  String?
  amount           Int      // in cents
  status           String   // paid | pending | failed
  createdAt        DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}
